NODE_ENV=dev

PORT=4000

### Database - Postgres
# npm run docker:dev (база в контейнере): PG_HOST=db_boilerplate, PG_PORT=5432
# npm run dev з базою в контейнері: PG_HOST=localhost, PG_PORT=8432
# npm run dev або npm run docker:remote із зовнішньою базою: адреса і порт сервера
PG_HOST=db_boilerplate
PG_PORT=5432
POSTGRES_USER=walter
POSTGRES_PASSWORD=white
POSTGRES_DB=boilerplate

### JWT
JWT_SECRET=change-me
JWT_EXPIRATION=15m
